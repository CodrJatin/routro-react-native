{
  "expo": {
    "name": "Routro",
    "slug": "routro",
    "scheme": "routro",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0F14",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e7ccff26-968f-48d3-9001-e17eea50d354"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.routro.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Routro uses your location to show your position on the metro map and to share it with friends you choose to broadcast to."
      }
    },
    "android": {
      "package": "com.routro.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "routro.vercel.app",
              "pathPrefix": "/i"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidMaterial3Theme.js",
      "./plugins/withAndroidAbiSplits.js",
      "@maplibre/maplibre-react-native",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Routro uses your location to show your position on the metro map and to share it with friends you choose to broadcast to."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#3dd68c"
        }
      ],
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e7ccff26-968f-48d3-9001-e17eea50d354"
      }
    },
    "owner": "jatinexpo"
  }
}
