# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Windows
Thumbs.db

# Editors
.vscode/

# Claude Code local runtime state (settings.json itself is shared/tracked)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local expo modules: source is tracked, gradle output is not (the /android
# rule above is root-anchored and doesn't reach these)
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/
modules/*/ios/build/

# Supabase CLI local state
/supabase/.temp
todo.md

# Python
scripts/__pycache__
# Renamed + checksummed APKs from scripts/release-apks.ts
/release
