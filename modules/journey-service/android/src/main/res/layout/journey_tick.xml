<?xml version="1.0" encoding="utf-8"?>
<!--
  One station. Weighted rather than sized, so four stops and forty both fill
  the notification edge to edge, and butted hard against its neighbours so the
  row reads as one continuous track rather than as a dashed line. A bare
  rectangle: no corner radius anywhere, which is the whole reason this meter is
  drawn by hand.
-->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/journey_tick"
    android:layout_width="0dp"
    android:layout_height="8dp"
    android:layout_weight="1"
    android:background="@color/journey_tick_ahead"
    android:contentDescription="@null" />
