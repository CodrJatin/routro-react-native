<?xml version="1.0" encoding="utf-8"?>
<!--
  A station where the journey changes lines.

  A square marker filled with the line being changed to, edged so it separates
  from whatever colour runs into it. That is the app's own grammar for a
  change: the itinerary boxes an interchange and fills its destination marker,
  and neither is a sliver standing out of a rail.

  Exactly as wide as it is, with no track strip behind it. A wider slot would
  leave a hair of track showing past the square on both sides, and that track
  is coloured for the leg the station belongs to, which is the line being left
  behind. The result was a stripe of the old colour appearing on the far side
  of the change.
-->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/journey_tick"
    android:layout_width="13dp"
    android:layout_height="13dp"
    android:src="@drawable/journey_square"
    android:scaleType="fitXY"
    android:tint="@color/journey_text_primary"
    android:contentDescription="@null" />
