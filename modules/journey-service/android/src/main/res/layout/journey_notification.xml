<?xml version="1.0" encoding="utf-8"?>
<!--
  The expanded journey notification.

  Hand-built rather than left to the platform's progress bar, for one reason:
  every shape Android draws there is a rounded capsule, and this app has square
  corners everywhere. The meter below is the same ghosted-and-filled rail the
  live journey card draws on the map, with the interchanges marked on it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="10dp">

  <TextView
      android:id="@+id/journey_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textColor="@color/journey_text_primary"
      android:textSize="15sp"
      android:textStyle="bold"
      android:maxLines="2"
      android:ellipsize="end" />

  <TextView
      android:id="@+id/journey_body"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:textColor="@color/journey_text_secondary"
      android:textSize="13sp"
      android:maxLines="1"
      android:ellipsize="end" />

  <!--
    The meter, set at runtime as a bitmap drawn to fit this box.

    fitXY rather than a fitted scale type: the bitmap is drawn at the width a
    notification is *estimated* to be, and the height it is actually given, so
    the vertical scale is 1 and the horizontal one is a few percent either way.
    Anything that preserved the aspect ratio would letterbox the bar instead of
    running it edge to edge, which is the one thing it has to do.

    Null here only so the picture is never announced as an unlabelled image if
    the runtime description is ever dropped; JourneyNotification replaces it
    with the position along the journey.
  -->
  <ImageView
      android:id="@+id/journey_meter"
      android:layout_width="match_parent"
      android:layout_height="18dp"
      android:layout_marginTop="12dp"
      android:scaleType="fitXY"
      android:contentDescription="@null" />

</LinearLayout>
