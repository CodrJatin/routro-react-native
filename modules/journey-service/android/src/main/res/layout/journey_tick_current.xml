<?xml version="1.0" encoding="utf-8"?>
<!--
  Where you are now: the itinerary's diamond, threaded onto the track rather
  than dropped into a hole in it.

  Three layers, back to front. The strip carries the track through the slot in
  the colour of the leg being ridden, so the marker sits at the leading edge of
  what has been travelled and nothing beyond it is tinted. The square appears
  only when this station is a change, showing the line about to be boarded
  underneath the marker rather than beside it, and it is drawn without the hard
  edge its standalone cousin gets so the diamond stays the only outline here.
  The diamond sits on top of both.

  Fixed width rather than weighted, unlike an ordinary tick. On a forty-station
  journey a weighted slot is about 7dp across, and a 7dp diamond is a speck.
  This one mark therefore opts out of sharing the row evenly, and keeps a size
  it can actually be seen at.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="16dp"
    android:layout_height="18dp">

  <ImageView
      android:id="@+id/journey_tick_track"
      android:layout_width="match_parent"
      android:layout_height="8dp"
      android:layout_gravity="center_vertical"
      android:background="@color/journey_tick_ahead"
      android:contentDescription="@null" />

  <ImageView
      android:id="@+id/journey_tick_change"
      android:layout_width="13dp"
      android:layout_height="13dp"
      android:layout_gravity="center"
      android:visibility="gone"
      android:contentDescription="@null" />

  <ImageView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_gravity="center"
      android:src="@drawable/journey_diamond"
      android:scaleType="fitCenter"
      android:tint="@color/journey_text_primary"
      android:contentDescription="@null" />

</FrameLayout>
