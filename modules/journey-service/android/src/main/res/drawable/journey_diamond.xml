<?xml version="1.0" encoding="utf-8"?>
<!--
  "You are here", lifted straight off the itinerary's current-station marker.

  A square stood on its corner, outlined and unfilled. A circle would read as a
  different kind of thing entirely: every marker this app draws is hard-edged,
  and the one that says where you are now has to belong to that family.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:pathData="M12,2.5 L21.5,12 L12,21.5 L2.5,12 Z"
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="3.5" />
</vector>
