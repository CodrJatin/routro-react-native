# Copy to .env and fill in from your Supabase project settings (Project Settings > API).
# The anon key is safe to embed in a client app -- Row Level Security policies
# (see supabase/migrations/0001_init.sql) are what actually protect the data.
# Never put the service_role/secret key in this app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
